{
	"name": "@narrative.io/app-bridge",
	"version": "0.1.1",
	"description": "Bridge between the Narrative platform and embedded third-party app UIs — origin-pinned MessageChannel protocol, zero runtime dependencies",
	"license": "MIT",
	"author": "Narrative I/O",
	"homepage": "https://github.com/narrative-io/app-bridge#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/narrative-io/app-bridge.git"
	},
	"bugs": {
		"url": "https://github.com/narrative-io/app-bridge/issues"
	},
	"keywords": [
		"narrative",
		"iframe",
		"postmessage",
		"messagechannel",
		"embed",
		"app-bridge",
		"protocol",
		"sdk"
	],
	"type": "module",
	"sideEffects": [
		"./dist/global.js",
		"./dist/app-bridge.global.js"
	],
	"engines": {
		"node": ">=20.19.0"
	},
	"packageManager": "bun@1.3.2",
	"workspaces": [
		"examples/*"
	],
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"exports": {
		"./guest": {
			"types": "./dist/guest.d.ts",
			"import": "./dist/guest.js"
		},
		"./host": {
			"types": "./dist/host.d.ts",
			"import": "./dist/host.js"
		},
		"./protocol": {
			"types": "./dist/protocol.d.ts",
			"import": "./dist/protocol.js"
		},
		"./dist/app-bridge.global.js": "./dist/app-bridge.global.js",
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"src",
		"!src/**/*.spec.ts",
		"!src/testing"
	],
	"scripts": {
		"build": "bun run build:clean && bun run build:types && bun run build:global",
		"prepare": "git config core.hooksPath .githooks || true",
		"build:clean": "rm -rf dist",
		"build:types": "tsc -p tsconfig.build.json",
		"build:global": "bun build src/global.ts --target=browser --format=iife --minify --sourcemap=linked --outdir=dist --entry-naming=app-bridge.global.js",
		"verify:build": "node scripts/verify-build.mjs",
		"example:typecheck": "bun run --cwd examples/embedded-app typecheck",
		"example:test": "bun run --cwd examples/embedded-app test",
		"example:build": "bun run --cwd examples/embedded-app build",
		"dev": "tsc -p tsconfig.build.json --watch",
		"test": "vitest run",
		"test:dev": "vitest watch",
		"test:coverage": "vitest run --coverage",
		"typecheck": "tsc -p tsconfig.json",
		"lint": "biome check --write .",
		"lint:check": "biome check --error-on-warnings .",
		"format": "biome format --write .",
		"prepublishOnly": "bun run build && bun run verify:build"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.5",
		"@commitlint/cli": "21.2.1",
		"@commitlint/config-conventional": "21.2.0",
		"@vitest/coverage-v8": "4.1.10",
		"typescript": "5.9.3",
		"vitest": "4.1.10"
	}
}
